{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage",
  "type": "object",
  "required": ["id", "chapter", "title", "type", "goal", "scene", "characters", "dialogue", "choices", "reward"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^stage-[0-9]+-[0-9]+$" },
    "chapter": { "type": "string", "pattern": "^chapter-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 2, "maxLength": 20 },
    "type": {
      "type": "string",
      "enum": ["tutorial", "knowledge_decision", "business_decision", "story_branch", "crisis"],
      "description": "对应方案 §5 的五类关卡"
    },
    "goal": { "type": "string", "minLength": 4, "maxLength": 40 },
    "scene": {
      "type": "string",
      "enum": ["bar", "door", "blackboard", "storage", "table", "backdoor", "street"],
      "description": "对应咖啡馆主界面的可点击区域"
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "character.id，'player' 为玩家自己"
    },
    "dialogue": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["speaker", "text"],
        "additionalProperties": false,
        "properties": {
          "speaker": { "type": "string" },
          "text": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      },
      "description": "1~3 轮对话为宜，单条不超过 120 字，手机端才不溢出"
    },
    "knowledge_brief": {
      "type": "array",
      "items": { "type": "string", "pattern": "^knowledge-[0-9]{3,}$" },
      "description": "决策前给玩家看的知识材料；knowledge_decision 类型必填"
    },
    "choices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "text", "result", "effects", "explanation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^choice-[a-d]$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 30 },
          "result": { "type": "string", "enum": ["correct", "acceptable", "wrong"] },
          "effects": { "$ref": "#/definitions/effects" },
          "explanation": { "type": "string", "minLength": 4, "maxLength": 150 },
          "knowledge_id": {
            "type": "string",
            "pattern": "^knowledge-[0-9]{3,}$",
            "description": "允许指向尚未产出的知识卡，校验器只报 warning"
          },
          "set_flags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "置为 true 的剧情标记，必须在 state-keys.json flags.known 中"
          },
          "next_stage": { "type": "string", "description": "选项级分支；story_branch 类型用" }
        }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "money": { "type": "integer" },
        "reputation": { "type": "integer" },
        "unlock_knowledge": {
          "type": "array",
          "items": { "type": "string", "pattern": "^knowledge-[0-9]{3,}$" }
        },
        "unlock_upgrade": {
          "type": "array",
          "items": { "type": "string", "enum": ["grinder", "brewer", "seats", "blackboard"] }
        }
      }
    },
    "next_stage": {
      "type": ["string", "null"],
      "description": "线性下一关；null 表示本章结束"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flags": { "type": "array", "items": { "type": "string" } },
        "completed_stages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recovery": {
      "type": "string",
      "maxLength": 150,
      "description": "选错后的补救提示（通常由林叔给出）。方案 §5 要求错误可恢复，不得 Game Over"
    }
  },
  "definitions": {
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "money": { "type": "integer" },
        "reputation": { "type": "integer" },
        "satisfaction_today": { "type": "integer" },
        "energy": { "type": "integer" },
        "trust": {
          "type": "object",
          "additionalProperties": { "type": "integer" },
          "description": "键必须是 state-keys.json trust.characters 中的角色 ID"
        },
        "inventory": {
          "type": "object",
          "additionalProperties": { "type": "integer" },
          "description": "键必须是已存在的 bean-xxx"
        }
      }
    }
  }
}
