{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CoffeeBean",
  "type": "object",
  "required": [
    "id",
    "name",
    "origin",
    "variety",
    "process",
    "roast_level",
    "flavor_tags",
    "purchase_price",
    "usable_drinks",
    "source_chapter",
    "source_quote"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^bean-[0-9]{3,}$" },
    "name": { "type": "string", "minLength": 1 },
    "origin": { "type": "string", "minLength": 1 },
    "variety": { "type": "string", "minLength": 1 },
    "process": {
      "type": "string",
      "enum": ["水洗", "日晒", "蜜处理", "厌氧发酵", "湿刨", "未标注"]
    },
    "roast_level": {
      "type": "string",
      "enum": ["浅烘", "中浅烘", "中烘", "中深烘", "深烘"]
    },
    "flavor_tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "purchase_price": { "type": "integer", "minimum": 1, "description": "每份采购成本，与 money 同单位" },
    "usable_drinks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^drink-[a-z0-9-]+$" }
    },
    "source_chapter": { "type": "string", "minLength": 1 },
    "source_quote": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source_book": { "type": "string" },
    "confidence": { "type": "string", "enum": ["high", "medium", "placeholder"] }
  }
}
